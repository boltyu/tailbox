{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      },
      {
        "tag": "dns-direct",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "proxy"
      }
    ],
    "rules": [
      {
        "inbound": "tun-in",
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-direct",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-box-tun",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "route_exclude_address": [
        "::/0"
      ]
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 1080
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": "dns-direct"
    }
  ],
  "route": {
    "find_process": true,
    "rules": [
      {
        "process_name": [
          "tailscaled.exe",
          "tailscale.exe",
          "tailscale-ipn.exe"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "inbound": "tun-in",
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "rule_set": [
          "direct-ips"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_cidr": [
          "100.64.0.0/10",
          "fd7a:115c:a1e0::/48"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "process_name": [
          "steamwebhelper.exe",
	  "ChromeSetup.exe"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "process_path_regex": [
          "(?i)^C:\\\\Program Files\\\\Google\\\\Chrome\\\\Application\\\\.*\\.exe$",
          "(?i)^C:\\\\Users\\\\light\\\\AppData\\\\Local\\\\antigravity\\\\.*\\.exe$",
          "(?i)^C:\\\\Program Files \\(x86\\)\\\\Google.*\\.exe$",
          "(?i)^C:\\\\Users\\\\light\\\\AppData\\\\Local\\\\agy\\\\.*\\.exe$"
        ],
        "outbound": "proxy"
      },
      {
        "action": "route",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "direct-ips",
        "type": "inline",
        "rules": [
          {
            "ip_cidr": [
              "35.212.129.200/32",
              "27.188.56.209/32"
            ]
          }
        ]
      }
    ],
    "auto_detect_interface": true,
    "final": "direct",
    "default_domain_resolver": "dns-direct"
  }
}
